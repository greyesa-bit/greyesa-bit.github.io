cat > /home/claude/work3/greyesa-bit.github.io-main/src/pages/index.astro << 'EOF'
---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { meta, about } from "../consts.ts";
import LucideIcon from "../components/LucideIcon.astro";
---

<Layout title={meta.about.title} description={meta.about.description}>
  <section>
    <h1 set:html={about.headLine} />
    <p>{about.tagLine}</p>
    <Image
      src={about.profilePic}
      alt="Foto de perfil"
      class="mx-auto my-4 w-32 rounded-full"
    />
    <p set:html={about.description} class="text-base-content/80" />
    <div class="my-4 flex gap-2">
      {
        about.links.map((link) => (
          <a
            href={link.href}
            target="_blank"
            class="btn btn-soft btn-circle btn-accent"
            title={link.icon}
          >
            <LucideIcon name={link.icon} />
          </a>
        ))
      }
    </div>
    <a class="btn btn-soft btn-accent w-full" href="/evidencias">Evidencias</a>
  </section>

  <section class="mt-10">
    <h2>
      <span class="fancy-highlight">Presentación</span>
    </h2>
    <p class="text-base-content/80 mt-1">
      Un video corto para que me conozcas: quién soy, qué me gusta y en que me puede servir bases de datos.
    </p>
    <div class="mt-4 aspect-video w-full overflow-hidden rounded-lg">
      <iframe
        class="h-full w-full"
        src={about.youtubeEmbedUrl}
        title="Video de presentación"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      ></iframe>
    </div>
  </section>
</Layout>
EOF
